# Next.js Patterns

## App Router

### Layouts

```typescript
import type { Metadata } from 'next';

export const metadata: Metadata = {
  title: 'Juno Bank | Premium Private Banking',
  description: 'Personalized banking for high net worth individuals',
};

const RootLayout = ({ children }: { children: React.ReactNode }) => {
  return (
    <html lang="en">
      <body>{children}</body>
    </html>
  );
};

export default RootLayout;
```

### Loading States

```typescript
const Loading = () => {
  return (
    <div className="flex min-h-screen items-center justify-center">
      <div className="h-8 w-8 animate-spin rounded-full border-2 border-primary border-t-transparent" />
    </div>
  );
};

export default Loading;
```

### Error Boundaries

```typescript
'use client';

const Error = ({
  error,
  reset,
}: {
  error: Error & { digest?: string };
  reset: () => void;
}) => {
  return (
    <div className="flex min-h-screen flex-col items-center justify-center gap-4">
      <h2 className="text-xl font-semibold">Something went wrong</h2>
      <button onClick={reset} className="rounded-lg bg-primary px-4 py-2 text-white">
        Try again
      </button>
    </div>
  );
};

export default Error;
```

## API Routes

```typescript
import { NextResponse } from 'next/server';
import { contactFormSchema } from '@/lib/validations';

export const POST = async (request: Request) => {
  try {
    const body = await request.json();
    const validated = contactFormSchema.parse(body);
    return NextResponse.json({ success: true });
  } catch (error) {
    return NextResponse.json({ error: 'Invalid request' }, { status: 400 });
  }
};
```

## Image & Link

Always use `next/image` and `next/link`:

```typescript
import Image from 'next/image';
import Link from 'next/link';

<Image
  src="/images/hero.jpg"
  alt="Description"
  width={1200}
  height={600}
  priority
  className="object-cover"
/>

<Link href="/private-banking" className="hover:text-primary">
  Private Banking
</Link>
```

## Metadata & SEO

```typescript
import type { Metadata } from 'next';

export const metadata: Metadata = {
  title: 'Private Banking | Juno Bank',
  description: 'Exclusive private banking services',
  openGraph: {
    title: 'Private Banking | Juno Bank',
    images: ['/images/og-private-banking.jpg'],
  },
};
```

## Dynamic Metadata

```typescript
type Props = { params: Promise<{ slug: string }> };

export const generateMetadata = async ({ params }: Props): Promise<Metadata> => {
  const { slug } = await params;
  return { title: `${slug} | Juno Bank` };
};
```
